# 灵枢网关。安装位置 /etc/systemd/system/lingshu.service
[Unit]
Description=Lingshu AI API gateway
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=lingshu
Group=lingshu
EnvironmentFile=/etc/lingshu/env
ExecStart=/opt/lingshu/lingshu serve
Restart=on-failure
RestartSec=3
# 进行中的流式请求最多等 30 秒再退出
TimeoutStopSec=35

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
