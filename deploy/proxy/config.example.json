{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "tag": "socks-in", "listen": "127.0.0.1", "port": 10808, "protocol": "socks", "settings": { "auth": "noauth", "udp": false } }
  ],
  "outbounds": [
    {
      "tag": "dmit-lax",
      "protocol": "vless",
      "settings": {
        "vnext": [
          { "address": "node.piqode.com", "port": 8443,
            "users": [ { "id": "<VLESS-UUID>", "encryption": "none", "flow": "xtls-rprx-vision" } ] }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": { "serverName": "www.cloudflare.com", "fingerprint": "chrome", "publicKey": "<REALITY-PUBLIC-KEY>", "shortId": "<SHORT-ID>" }
      }
    }
  ]
}
